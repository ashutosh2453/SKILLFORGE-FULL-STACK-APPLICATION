# SkillForge Environment Variables

# Backend Flask Configuration
FLASK_ENV=development
PORT=5000
# Leave unset for local development (dev-only keys are used).
# Production refuses to start without random values of 32+ characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
# One-click demo logins (including admin, no password). Default: on in development, off in production.
SKILLFORGE_DEMO_MODE=
# Bind address for `python run.py` (debug server). Keep 127.0.0.1; use gunicorn for deployments.
HOST=127.0.0.1

# Database Connection
# Defaults to SQLite (sqlite:///skillforge.db) if unset.
# For PostgreSQL: postgresql://username:password@localhost:5432/skillforge
DATABASE_URL=sqlite:///skillforge.db

# Optional AI / Telemetry API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
