# SkillForge Environment Variables

# Backend Flask Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=skillforge-super-secret-production-key-2026
JWT_SECRET_KEY=skillforge-jwt-secure-signing-key-2026

# Database Connection
# Defaults to SQLite (sqlite:///skillforge.db) if unset.
# For PostgreSQL: postgresql://username:password@localhost:5432/skillforge
DATABASE_URL=sqlite:///skillforge.db

# Optional AI / Telemetry API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
